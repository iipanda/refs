---
import Download from '../assets/icons/download.svg';
import { downloadUrl, githubUrl } from '../lib/links';

interface Props { iconSize?: number; class?: string; }
const { iconSize = 20, class: className } = Astro.props;
---
<div class:list={['actions', className]}>
  <a class="button button-yellow" href={downloadUrl}>Download for Mac <Download width={iconSize} height={iconSize} aria-hidden="true" /></a>
  <a class="button button-ghost" href={githubUrl}><span class="gh-mark" aria-hidden="true"></span>View on GitHub</a>
</div>

<style>
  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: 21px; }
  @media (max-width: 760px) { .actions { gap: 16px; } }
</style>
