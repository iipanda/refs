---
import CallToActions from './CallToActions.astro';
import HeroScene from './HeroScene.astro';
import PlatformLine from './PlatformLine.astro';

interface Props { image: string; thumbImage: string; tinyImage: string; }
const props = Astro.props;
---
<section class="hero shell" aria-labelledby="hero-title">
  <div class="hero-copy">
    <h1 id="hero-title">Good ideas.<br /><span>Kept close.</span></h1>
    <p>Save the UI you love. Remember why.<br />Bring it into your next build.</p>
    <CallToActions />
    <PlatformLine />
  </div>
  <HeroScene {...props} />
</section>

<style>
  .hero { display: grid; grid-template-columns: .9fr 1.15fr; align-items: center; gap: 45px; min-height: 660px; padding-block: 64px 102px; }
  h1 { font-size: clamp(62px, 6.5vw, 92px); line-height: 1.02; letter-spacing: -.035em; white-space: nowrap; }
  h1 span { color: var(--yellow); }
  .hero-copy > p { margin: 25px 0 29px; color: var(--secondary); font-size: 18px; line-height: 1.7; }
  @media (min-width: 1550px) {
    .hero { gap: 70px; min-height: 730px; }
    h1 { font-size: 96px; }
  }
  @media (max-width: 1100px) {
    .hero { gap: 30px; min-height: 610px; padding-block: 56px 78px; }
    h1 { font-size: clamp(51px, 6.9vw, 74px); }
  }
  @media (max-width: 760px) {
    .hero { grid-template-columns: 1fr; gap: 55px; min-height: auto; padding-block: 39px 77px; }
    h1 { font-size: clamp(56px, 11.8vw, 80px); }
    .hero-copy > p { margin-top: 21px; font-size: 16px; }
  }
  @media (max-width: 360px) {
    h1 { font-size: 15.5vw; }
  }
</style>
