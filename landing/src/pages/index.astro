---
import { getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Hero from '../components/Hero.astro';
import Intro from '../components/Intro.astro';
import WorkflowSection from '../components/WorkflowSection.astro';
import LibrarySection from '../components/LibrarySection.astro';
import AgentsSection from '../components/AgentsSection.astro';
import Faq from '../components/Faq.astro';
import Closing from '../components/Closing.astro';
import SiteFooter from '../components/SiteFooter.astro';
import studio from '../assets/studio.jpg';

// One sourced photo, sized for each place it appears.
const [large, thumb, tiny] = await Promise.all([960, 480, 120].map(width => getImage({ src: studio, width, format: 'webp' })));
const image = large.src, thumbImage = thumb.src, tinyImage = tiny.src;
const siteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Refs',
  url: new URL('/', Astro.site).href,
};
---
<BaseLayout
  title="Refs | UI Reference Library for macOS"
  description="Capture screenshots and videos, save notes and sources, and share UI references with coding agents. Refs is a free, local reference library for macOS."
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(siteSchema).replace(/</g, '\\u003c')} />
  <SiteHeader />
  <main id="main">
    <Hero {image} {thumbImage} {tinyImage} />
    <Intro />
    <WorkflowSection {image} {thumbImage} />
    <LibrarySection {thumbImage} />
    <AgentsSection image={thumbImage} />
    <Faq />
    <Closing />
  </main>
  <SiteFooter />
</BaseLayout>
