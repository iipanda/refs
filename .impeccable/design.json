  "narrative": {
    "northStar": "The Designer's Editing Table",
    "overview": "This is an extraction of the implemented marketing surface in `landing/`, created for code-led local static preview. Warm yellow, charcoal and the user-confirmed quotation icon carry the identity. Generous space, large conversational headings, cropped source material and offset notes make the reference and the reason for keeping it visible together.\n\nThe North Star, descriptive color names, typography pairing and page composition document this implementation for review; they are not claimed as a user-approved permanent style. The native Swift UI is not redesigned by this specification. Audience and CTA defaults remain assumptions in `PRODUCT.md`. Page strategy and the selection record belong in `landing/DIRECTION.md`.",
    "keyCharacteristics": [
      "Warm yellow identity against neutral charcoal.",
      "Large compact display type with quieter readable workflow text.",
      "Layered illustrative sources and personal notes.",
      "User-operated state changes with reduced-motion support."
    ],
    "rules": [
      {
        "name": "The Identity Rule",
        "body": "Preserve the confirmed quotation icon and yellow/charcoal identity in this surface; other visual choices remain reviewable implementation decisions.",
        "section": "colors"
      }
    ],
    "dos": [
      "**Do** preserve the confirmed quotation icon and yellow/charcoal identity.",
      "**Do** keep operative workflow text at the implemented 12\u201314px sizes.",
      "**Do** retain labeled synthetic examples, keyboard workflow controls and visible focus.",
      "**Do** preserve state access when reduced motion is enabled.",
      "**Do** use this specification only for the implemented landing/ marketing surface."
    ],
    "donts": [
      "**Don't** treat illustrative source windows as screenshots of the native app.",
      "**Don't** promote this review implementation into an approved permanent style or production launch.",
      "**Don't** apply this landing-page visual extraction as a redesign of the native Swift UI.",
      "**Don't** substitute font glyphs for the implemented SVG action icons."
    ]
